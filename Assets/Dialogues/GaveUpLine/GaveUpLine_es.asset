  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: GaveUpLine_es
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 7bdb7eacfbf7e7d4cb7f473be95b1703, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 4641435648
    m_Localized: Hice la fila solo para practicar mi habilidad de no hacer nada.
    m_Metadata:
      m_Items: []
  - m_Id: 106449776640
    m_Localized: Ni voy a pedir nada, para mantener mi tradición de no terminar lo que empiezo.
    m_Metadata:
      m_Items: []
  - m_Id: 126779568128
    m_Localized: Iba a pedir algo, pero se me acabó el valor. Y la paciencia también.
    m_Metadata:
      m_Items: []
  - m_Id: 155728654336
    m_Localized: Yo solo quería un pastel... pero parece que pedir eso ya era demasiado para la vida.
    m_Metadata:
      m_Items: []
  - m_Id: 200410574848
    m_Localized: Entré a la fila con hambre y salí con preguntas existenciales que nadie me pidió.
    m_Metadata:
      m_Items: []
  - m_Id: 216168574976
    m_Localized: Me encantó la experiencia de no pedir nada. Muy eficiente.
    m_Metadata:
      m_Items: []
  - m_Id: 241267290112
    m_Localized: La atención inexistente fue impecable, felicidades.
    m_Metadata:
      m_Items: []
  - m_Id: 267003539456
    m_Localized: Qué experiencia tan increíble quedarme aquí sin hacer nada. Exactamente lo que planeaba.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
