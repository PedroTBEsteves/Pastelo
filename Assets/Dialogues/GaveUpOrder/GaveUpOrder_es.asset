  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: GaveUpOrder_es
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 190d5a78372d24045ba36df6a0634436, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 4565938176
    m_Localized: Esperé, creí... y me decepcionaron otra vez. Un clásico.
    m_Metadata:
      m_Items: []
  - m_Id: 24446939136
    m_Localized: 'Mi pedido se volvió una leyenda urbana: todos hablan de él, pero nadie lo ha visto.'
    m_Metadata:
      m_Items: []
  - m_Id: 41291264000
    m_Localized: Qué rapidez... por un momento pensé que hoy sí me llevaría mi pastel.
    m_Metadata:
      m_Items: []
  - m_Id: 74992496640
    m_Localized: No pasa nada, en realidad ni quería comer.
    m_Metadata:
      m_Items: []
  - m_Id: 81451724800
    m_Localized: Sin prisa, claramente tengo todo el día para esto.
    m_Metadata:
      m_Items: []
  - m_Id: 111722016768
    m_Localized: Está bien, el hambre es psicológico.
    m_Metadata:
      m_Items: []
  - m_Id: 122606235648
    m_Localized: Pedí un pastel y recibí un recordatorio de que esperar nunca vale la pena.
    m_Metadata:
      m_Items: []
  - m_Id: 147558150144
    m_Localized: El pedido no llegó, pero la decepción siempre llega puntual.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
