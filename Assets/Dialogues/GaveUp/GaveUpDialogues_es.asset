  m_TableData:
  - m_Id: 5270581248
    m_Localized: ¿El pastel viene caminando desde el otro lado del país?
    m_Metadata:
      m_Items: []
  - m_Id: 10018533376
    m_Localized: ¿Lo están friendo o está estudiando gastronomía?
    m_Metadata:
      m_Items: []
  - m_Id: 14279946240
    m_Localized: Ya envejecí dos años esperando este pastel.
    m_Metadata:
      m_Items: []
  - m_Id: 18558136320
    m_Localized: ¿La demora es porque están cultivando los ingredientes?
    m_Metadata:
      m_Items: []
  - m_Id: 27420700672
    m_Localized: ¿Lo trae una tortuga repartidora, verdad?
    m_Metadata:
      m_Items: []
